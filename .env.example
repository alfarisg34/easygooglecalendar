# ==========================================
# 1. GOOGLE GEMINI AI (BYOK)
# ==========================================
# Optional: Default fallback API key if you want to host a private instance.
# In public BYOK mode, users provide their own Gemini API keys directly in the browser.
GEMINI_API_KEY=

# ==========================================
# 2. GOOGLE OAUTH 2.0 (DIRECT AUTO-SYNC 0-CLICK)
# ==========================================
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth Client ID (Web Application)
# Authorized redirect URI: https://<your-vercel-domain>.vercel.app/api/auth/callback (dan http://localhost:3000/api/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ==========================================
# 3. TELEGRAM BOT (OPTIONAL FOR GLOBAL BOT INSTANCE)
# ==========================================
TELEGRAM_BOT_TOKEN=

# ==========================================
# 4. PERSISTENT TOKEN STORAGE (VERCEL KV / UPSTASH REDIS)
# ==========================================
# Di Vercel Dashboard: Storage -> Create KV Database -> Connect to Project (Otomatis terisi)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ==========================================
# 5. CUSTOM OCR SERVICE
# ==========================================
NEXT_PUBLIC_OCR_SERVICE_URL=https://ocr.alfarighilmana.my.id/api/ocr
