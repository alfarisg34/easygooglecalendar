# ==========================================
# 1. NEON POSTGRESQL (VERCEL POSTGRES)
# ==========================================
# Dapatkan dari Vercel Dashboard -> Storage -> Create Neon Postgres -> Connect to Project
# Atau dari neon.tech console
DATABASE_URL=postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Rahasia enkripsi JWT sesi login
SESSION_SECRET=super-secret-random-key-change-in-production-2026

# ==========================================
# 2. GOOGLE OAUTH 2.0 (LOGIN & CALENDAR SYNC)
# ==========================================
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth Client ID (Web Application)
# Authorized redirect URI: https://<your-vercel-domain>.vercel.app/api/auth/callback (dan http://localhost:3000/api/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ==========================================
# 3. GOOGLE GEMINI AI (BYOK FALLBACK)
# ==========================================
# Default fallback API key jika tidak diatur di Pengaturan user
GEMINI_API_KEY=

# ==========================================
# 4. TELEGRAM BOT (OPTIONAL GLOBAL BOT)
# ==========================================
TELEGRAM_BOT_TOKEN=

# ==========================================
# 5. CUSTOM OCR SERVICE (OPTIONAL)
# ==========================================
NEXT_PUBLIC_OCR_SERVICE_URL=https://ocr.alfarighilmana.my.id/api/ocr
